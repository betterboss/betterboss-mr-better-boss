# BetterBoss Sidebar Configuration
# ===================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# JobTread API Configuration
JOBTREAD_API_URL=https://api.jobtread.com/graphql
JOBTREAD_CLIENT_ID=your-jobtread-client-id
JOBTREAD_CLIENT_SECRET=your-jobtread-client-secret

# AI Configuration (for AI-powered features)
OPENAI_API_KEY=your-openai-api-key
# OR use Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# GoHighLevel Integration
# Get your Private Integration token from GHL Settings > Integrations > Private Integrations
GHL_API_TOKEN=your-gohighlevel-api-token
# Your GHL sub-account/location ID (found in GHL Settings > Business Info)
GHL_LOCATION_ID=your-gohighlevel-location-id
# Optional: GHL inbound webhook URL to trigger GHL workflows after lead sync
GHL_WORKFLOW_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-webhook-id
# Optional: Secret to verify incoming GHL webhook events
GHL_WEBHOOK_SECRET=your-ghl-webhook-secret

# Webhook Configuration
# Shared secret to verify incoming JobTread webhook events
JOBTREAD_WEBHOOK_SECRET=your-jobtread-webhook-secret
# JT API key used by the webhook sync engine (can be same as user's key)
JOBTREAD_SYNC_API_KEY=your-jobtread-sync-api-key

# Application Settings
NEXT_PUBLIC_APP_NAME=BetterBoss Sidebar
NEXT_PUBLIC_APP_URL=http://localhost:3000
