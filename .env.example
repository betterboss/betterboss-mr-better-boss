# BetterBoss Sidebar Configuration
# ===================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# JobTread API Configuration
JOBTREAD_API_URL=https://api.jobtread.com/graphql
JOBTREAD_CLIENT_ID=your-jobtread-client-id
JOBTREAD_CLIENT_SECRET=your-jobtread-client-secret

# AI Configuration (for AI-powered features)
OPENAI_API_KEY=your-openai-api-key
# OR use Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key

# GoHighLevel (GHL) Integration
# Used by webhook endpoints for real-time JT↔GHL contact sync.
GHL_API_KEY=your-ghl-api-key
GHL_LOCATION_ID=your-ghl-location-id
# Service token for GHL→JT webhook (server-side, no user session needed)
JOBTREAD_SERVICE_TOKEN=your-jobtread-service-api-key

# Webhook secret — secures /api/webhooks/jobtread and /api/webhooks/ghl endpoints.
# Generate with: openssl rand -hex 32
# Pass as ?secret=<value> in your JT/GHL workflow webhook URLs.
WEBHOOK_SECRET=your-webhook-secret

# Application Settings
NEXT_PUBLIC_APP_NAME=BetterBoss Sidebar
NEXT_PUBLIC_APP_URL=http://localhost:3000
